# .gitignore — generated by speckit init (ADR-0025).
#
# Generic starting point. Extend the build-outputs section below with this
# project's real toolchain artifacts.

# --- OS junk ---------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# --- Editor / IDE ----------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~

# --- Build outputs ---------------------------------------------------------
# TODO (maintainer): add this project's build artifacts here — e.g. build/,
# out/, *.o, *.class, coverage/, .gradle/.
target/
dist/
node_modules/

# --- Logs ------------------------------------------------------------------
*.log
logs/

# --- Environment / secrets -------------------------------------------------
.env
.env.*
!.env.example

# --- speckit control plane (ADR-0028, ADR-0029) ----------------------------
# The born-local SQLite databases and their WAL/SHM sidecars are never
# committed: `speckit-local.db` (durable lock/audit) and `speckit-index.db`
# (the rebuildable derived cache). All speckit runtime/derived state lives
# under doc/.specify; the committed control plane is the text in doc/arch.
doc/.specify/speckit-*.db
doc/.specify/speckit-*.db-wal
doc/.specify/speckit-*.db-shm
