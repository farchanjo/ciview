#!/usr/bin/env bash
# ciview local commit-msg — conventional commits (lightweight)
set -euo pipefail

MSG_FILE="${1:-}"
[[ -n "$MSG_FILE" && -f "$MSG_FILE" ]] || exit 0

if [[ "${SKIP_HOOKS:-0}" == "1" ]]; then
  exit 0
fi

# First non-comment, non-empty line
SUBJECT="$(grep -vE '^\s*(#|$)' "$MSG_FILE" | head -1 || true)"
SUBJECT="$(echo "$SUBJECT" | sed 's/[[:space:]]*$//')"

if [[ -z "$SUBJECT" ]]; then
  echo "commit-msg: empty subject" >&2
  exit 1
fi

# Allow merge/revert/fixup commits
if [[ "$SUBJECT" =~ ^(Merge |Revert |fixup! |squash! ) ]]; then
  exit 0
fi

# type(scope)?: subject   — scope optional
# types aligned with common conventional commits used in this repo
if [[ ! "$SUBJECT" =~ ^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9._/-]+\))?(!)?:[[:space:]].+ ]]; then
  cat >&2 <<'EOF'
commit-msg: subject must follow Conventional Commits:

  <type>(optional-scope): <description>

  types: feat fix docs style refactor perf test build ci chore revert

  examples:
    feat: add stage board navigation
    fix(poll): refresh pipelines while idle
    chore: release v0.1.2
    docs(agents): document git hooks

Skip hooks only if needed: SKIP_HOOKS=1 git commit ...
EOF
  echo "commit-msg: got: $SUBJECT" >&2
  exit 1
fi

# Soft length hint (not hard fail over 100 — warn only)
if [[ ${#SUBJECT} -gt 100 ]]; then
  echo "commit-msg: warning: subject is ${#SUBJECT} chars (prefer ≤72)" >&2
fi

exit 0
